# Example environment file for CAIPE DeepEval Evaluation service.
# Copy this file to .env for local or container deployment.

# ==========================================
# API Server Host & Port Settings
# ==========================================
HOST="0.0.0.0"
PORT="8000"

# ==========================================
# Security, Auth & Dev Bypass Flags
# (Used by start_api_server.sh, start_api_server_auth.sh, start_api_server_auth_db.sh)
# ==========================================
# Set ALLOW_UNAUTHENTICATED_ACCESS="true" for local unauthenticated dev mode, or "false" to enforce auth
ALLOW_UNAUTHENTICATED_ACCESS="false"
CAIPE_UNSAFE_RBAC_BYPASS="false"

# Static API key validation (Alternative to OIDC Bearer token)
DEEPEVAL_API_KEY="caipe-deepeval-auth-secret-key-12345"

# ==========================================
# OIDC Provider & Keycloak Token Validation
# ==========================================
OIDC_ISSUER="https://caipe.homelab/realms/caipe"
OIDC_AUDIENCE="caipe-ui"
OIDC_JWKS_URL="https://keycloak.caipe.homelab/realms/caipe/protocol/openid-connect/certs"
OIDC_VERIFY_SSL="false"

# Keycloak OIDC Client Credentials (for client_credentials grant token retrieval)
CAIPE_CLIENT_ID="caipe-ui"
CAIPE_CLIENT_SECRET="your-keycloak-client-secret"

# Optional Kubernetes config path for secret retrieval (k3s / homelab cluster)
# KUBECONFIG="/etc/rancher/k3s/k3s.yaml"

# SSL Certificate verification override (if using custom internal CA)
# SSL_CERT_FILE="/tmp/caipe_tls.crt"
# REQUESTS_CA_BUNDLE="/tmp/caipe_tls.crt"

# ==========================================
# LLM Proxy / OpenAI-Compatible API Gateway
# ==========================================
OPENAI_API_KEY="sk-your-openai-or-lite-llm-proxy-key"
OPENAI_ENDPOINT="https://api.openai.com/v1"
OPENAI_MODEL_NAME="bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
EMBEDDINGS_MODEL="bedrock/amazon.titan-embed-text-v2:0"

# ==========================================
# CAIPE System Endpoints
# ==========================================
CAIPE_SUPERVISOR_URL="https://caipe.homelab"
CAIPE_BASE_URL="https://rag.caipe.homelab"
INSECURE_SSL="true"

# ==========================================
# PostgreSQL Database Persistence Configuration
# (Used by Question Set Manager, job queue, and result sinks)
# ==========================================
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="caipe_eval"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-postgres-password"
DATABASE_URL="postgresql://postgres:your-secure-postgres-password@localhost:5432/caipe_eval"

# ==========================================
# Benchmark Dataset Paths & DataSource IDs
# ==========================================
# Enterprise RAG Bench
ENTERPRISE_RAGAS_DATASOURCE="enterprise_rag_bench"
ENTERPRISE_CAIPE_DATASOURCE_ID="enterprise_rag_bench"
ENTERPRISE_QUESTIONS_PATH="/app/data/enterprise_rag_bench_questions.jsonl"
ENTERPRISE_RAG_EVAL_PROMPT_STYLE="generation" # Options: "generation" (default/detailed) or "short"

# HotpotQA
HOTPOTQA_CAIPE_DATASOURCE_ID="hotpotqa_sample"
HOTPOTQA_RAGAS_DATASOURCE="hotpotqa"
HOTPOTQA_QUESTIONS_PATH="/app/data/hotpotqa_full_questions.jsonl"
RAG_EVAL_PROMPT_STYLE="short" # Options: "generation" or "short"
